# Copy this file to `.env` and adjust if needed.
# Nothing below is required to have a paid value — Vrox runs 100% free by default.

# Which local Ollama model to use as the "brain".
# Pull it first with:  ollama pull qwen2.5:7b-instruct
VROX_LLM_MODEL=qwen2.5:7b-instruct

# Ollama server address (default is fine if Ollama runs on the same machine)
OLLAMA_HOST=http://localhost:11434

# Whisper model size for speech-to-text. "small" is a good speed/accuracy
# balance on a normal laptop. Options: tiny, base, small, medium, large-v3
VROX_WHISPER_MODEL=small

# Text-to-speech engine: "edge" (free, natural, needs internet) or
# "offline" (pyttsx3, fully offline, more robotic)
VROX_TTS_ENGINE=edge

# Voice used by edge-tts. Good deep/heavy male, bilingual-friendly choices:
#   en-IN-PrabhatNeural  (Indian-English male, calm and grounded)
#   hi-IN-MadhurNeural   (Hindi male, deep tone)
VROX_TTS_VOICE=en-IN-PrabhatNeural

# --- OPTIONAL: only fill this in if you deliberately want ElevenLabs voices ---
# instead of the free edge-tts engine. Leave blank to stay at zero cost.
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=

# Host/port for the LAN web server (0.0.0.0 makes it reachable from your
# phone on the same WiFi, e.g. http://<your-pc-lan-ip>:8000)
VROX_SERVER_HOST=0.0.0.0
VROX_SERVER_PORT=8000
